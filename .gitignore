# --- Python / сборка ---
__pycache__/
*.pyc
venv/
.env

# --- Секреты ---
.env
credentials.json

# --- Логи и временные файлы ---
*.log
*.log.*
*.tmp
build_log.txt
build_err.txt
exe_err.log
exe_run.log
pyi_log.txt
test_out.txt
data/logs/
data/settings.json
data/settings.json.bak

# --- Артефакты сборки PyInstaller ---
build/
dist/
release/
*.spec.bak

# --- IDE ---
.vscode/
.idea/

# --- Кэш тестов ---
.pytest_cache/

# --- Модели ---
# Vosk скачивается автоматически при первом запуске (см. wake_word.py) —
# не должен лежать в репозитории (~88 МБ).
models/vosk-model-small-ru-0.22/
# ВНИМАНИЕ: models/tts/ (Piper, ~61 МБ) НЕ игнорируется — в отличие от Vosk,
# для него в коде нет авто-скачивания (tts_piper.py), так что при чистом
# чекауте без этой папки синтез речи не заработает. Если решите не хранить
# её в git — сначала добавьте для неё такую же логику загрузки, как у Vosk,
# либо подключите Git LFS.

# --- Пользовательские данные (создаются приложением на каждой машине) ---
# Индекс файлов, кэш ответов, заметки и метаданные сканирования — это данные
# конкретного пользователя, а не часть исходников (см. ZEUS_cleanup_TZ.md §4).
# База программ этой машины (абсолютные пути). На новом компьютере
# файл создаётся из commands.template.json и наполняется сканером.
data/commands.json
data/index.json
data/index_meta.json
data/cache.json
data/notes.txt
data/file_cache.json

# --- Отладочные дампы (перехваты stdout/stderr запусков и сборок) ---
# Создаются временно при диагностике; в репозитории не нужны.
/_*_out.txt
/_*_err.txt
/exe_*.log
/pyi_log.txt
/test_out.txt
